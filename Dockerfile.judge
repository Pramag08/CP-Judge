# Same runtime base and build process as the pinned upstream .docker/tier1/Dockerfile.
# Record the resolved base digest; this image has NOT been built in this workspace.
ARG RUNTIME_IMAGE=dmoj/runtimes-tier1:latest
FROM ${RUNTIME_IMAGE}
ARG DMOJ_COMMIT=1245dc4158dbb9e906c4c103e1ea939e012ee79b
RUN mkdir /judge /problems && cd /judge && \
    curl --fail -L https://github.com/DMOJ/judge-server/archive/${DMOJ_COMMIT}.tar.gz | tar -xz --strip-components=1 && \
    python3 -m venv --prompt=DMOJ /env && \
    /env/bin/pip3 install cython setuptools && \
    /env/bin/pip3 install -e . && \
    HOME=~judge . ~judge/.profile && \
    runuser -u judge -w PATH -- /env/bin/dmoj-autoconf -V > /judge-runtime-paths.yml
COPY tools/judge-entry.sh /compat-entry
RUN chmod 755 /compat-entry
USER judge
ENV DMOJ_IN_DOCKER=1 PYTHONUNBUFFERED=1
WORKDIR /tmp
ENTRYPOINT ["/compat-entry"]
